{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:apk": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:android:internal": "eas build --platform android --profile internal",
    "eas:android:production": "eas build --platform android --profile production",
    "eas:android:production:submit": "eas build --platform android --profile production --auto-submit"
  },
  "dependencies": {
    "@crypto/cipher-core": "workspace:*",
    "@crypto/galaxy-elements": "workspace:*",
    "@crypto/modcalc-core": "workspace:*",
    "@crypto/patch-notes": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.8",
    "@react-navigation/native": "^7.2.1",
    "expo": "~55.0.8",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
