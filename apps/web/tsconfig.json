{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@crypto/cipher-core": ["../../packages/cipher-core/src/index.ts"],
      "@crypto/cipher-contract": [
        "../../packages/cipher-contract/src/types.ts"
      ],
      "@crypto/galaxy-elements": [
        "../../packages/galaxy-elements/src/index.ts"
      ],
      "@crypto/patch-notes": ["../../packages/patch-notes/src/index.ts"],
      "@crypto/patch-notes/client": ["../../packages/patch-notes/src/client.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
